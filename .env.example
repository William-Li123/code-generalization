# The repository contains code only. Point these variables at external storage.
CG_DATA_ROOT=/path/to/code-generalization-data
CG_DATA_TEST_ROOT=/path/to/code-generalization-data/paper_standard11
CG_MODEL_ROOT=/path/to/huggingface-models
CG_OUTPUT_ROOT=/path/to/experiment-outputs
CG_VERL_RECIPE_DIR=/path/to/verl-recipe
CG_VERL_ENV=/path/to/verl-environment

# Optional Linux isolation paths for the portable category runner.
CG_BWRAP=/usr/bin/bwrap
CG_SANDBOX_PACKAGES=/path/to/python3.10/site-packages
